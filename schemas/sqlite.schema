// @name SQLite database
// @entry SqliteHeader
// @endian be
// @desc SQLite 3 database header (first 100 bytes). SQLite stores all
//       multi-byte integers big-endian.

enum SqliteFormatVersion : u8 {
    Legacy = 1   // rollback journal
    WAL    = 2   // write-ahead log
}

enum SqliteTextEncoding : u32 {
    Utf8    = 1
    Utf16le = 2
    Utf16be = 3
}

struct SqliteHeader {
    magic               string[16]          "\"SQLite format 3\\0\""
    pageSize            u16                 "page size in bytes (value 1 = 65536)"
    writeVersion        SqliteFormatVersion "file format write version"
    readVersion         SqliteFormatVersion "file format read version"
    reservedSpace       u8                  "bytes reserved at end of each page"
    maxPayloadFraction  u8                  "maximum embedded payload fraction (64)"
    minPayloadFraction  u8                  "minimum embedded payload fraction (32)"
    leafPayloadFraction u8                  "leaf payload fraction (32)"
    changeCounter       u32                 "file change counter"
    databaseSizePages   u32                 "database size, in pages"
    firstFreelistPage   u32                 "page number of the first freelist trunk page"
    freelistPageCount   u32                 "total number of freelist pages"
    schemaCookie        u32                 "schema cookie"
    schemaFormat        u32                 "schema format number (1-4)"
    defaultCacheSize    u32                 "default page cache size"
    largestRootPage     u32                 "largest root b-tree page (vacuum modes)"
    textEncoding        SqliteTextEncoding  "database text encoding"
    userVersion         u32                 "user version (PRAGMA user_version)"
    incrementalVacuum   u32                 "incremental-vacuum mode (nonzero = on)"
    applicationId       u32                 "application ID (PRAGMA application_id)"
    reserved            bytes[20]           "reserved for expansion (must be zero)"
    versionValidFor     u32                 "version-valid-for number"
    sqliteVersion       u32                 "SQLITE_VERSION_NUMBER that last wrote"
}
